# Copy to compose.console.yaml. Individual Bot settings are managed in the Web UI.
name: nekodock
services:
  console:
    build:
      context: .
      dockerfile: Dockerfile.console
    image: nekodock-console:latest
    init: true
    restart: unless-stopped
    ports:
      # Keep the host binding on loopback for the single-admin console.
      - "127.0.0.1:4180:4180"
    environment:
      CONSOLE_HOST: 0.0.0.0
      CONSOLE_PORT: "4180"
      CONSOLE_DATA_DIR: /console-data
      DOCKER_SOCKET: /var/run/docker.sock
      # Build this shared image once; all managed workers use it.
      WORKER_IMAGE: nekodock-worker:latest
      WORKER_NETWORK: nekodock
      # Container-to-container URL, independent of the published host port.
      WORKER_CONSOLE_URL: http://console:4180
      # Generated automatically; the runner receives only its scoped credential.
      CONSOLE_PLUGIN_RUNNER_TOKEN_FILE: /plugin-bootstrap/runner.token
    volumes:
      # Contains DB configuration, encrypted secrets and an independent master key.
      - ./console-data:/console-data
      # Control plane only. Do not add this mount to Worker containers.
      - /var/run/docker.sock:/var/run/docker.sock
      - plugin-bootstrap:/plugin-bootstrap
    networks:
      - console
    extra_hosts:
      - host.docker.internal:host-gateway
    stop_grace_period: 30s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  # Shared downloader. Per-instance plugin settings remain in the Console DB.
  plugin-runner:
    build:
      context: .
      dockerfile: Dockerfile.plugin-runner
    image: nekodock-plugin-runner:latest
    init: true
    restart: unless-stopped
    depends_on: [console]
    environment:
      CONSOLE_URL: http://console:4180
      PLUGIN_RUNNER_TOKEN_FILE: /plugin-bootstrap/runner.token
      PLUGIN_RUNNER_WORKDIR: /runner-work
    volumes:
      - plugin-bootstrap:/plugin-bootstrap:ro
      - plugin-runner-work:/runner-work
    networks: [console]
    extra_hosts:
      - host.docker.internal:host-gateway
    cpus: 1.0
    mem_limit: 512m
    pids_limit: 128
    stop_grace_period: 30s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  # This service defines the worker build; it is not a running bot instance.
  # docker compose -f compose.console.yaml --profile build build worker-image
  worker-image:
    profiles: [build]
    image: nekodock-worker:latest
    build:
      context: .
      dockerfile: Dockerfile

networks:
  console:
    # Dynamic worker containers join this same network.
    name: nekodock

volumes:
  plugin-bootstrap:
  plugin-runner-work:
