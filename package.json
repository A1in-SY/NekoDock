{
  "name": "nekodock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test dist/test/*.test.js web/test/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "build:web": "tsc -p web/tsconfig.json --noEmit && vite build web",
    "build:all": "npm run build && npm run build:web",
    "start:console": "node dist/src/console/main.js",
    "console:import": "node dist/src/console/import.js",
    "test:web": "node --test web/test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.7",
    "echarts": "6.1.0",
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typebox": "1.3.27",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.2"
    }
  }
}
